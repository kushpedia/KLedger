# KiliLedger Pro Environment Configuration Template
DJANGO_SETTINGS_MODULE=kililedger.settings.development
DJANGO_SECRET_KEY=replace-with-50-char-cryptographic-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app.kililedger.co.ke

# Production PostgreSQL 16 Settings (used when DJANGO_SETTINGS_MODULE=kililedger.settings.production)
POSTGRES_DB=kililedger_prod
POSTGRES_USER=kililedger_user
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
